{
  "info": {
    "name": "SEP System - FIWARE",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleção do SEP System (GS 2026.2). Defina a variável url com o IP do Raspberry Pi."
