    {
      "name": "4. Histórico (STH-Comet)",
      "item": [
        {
          "name": "Criar subscription para o STH",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "fiware-service",
                "value": "smart"
              },
              {
                "key": "fiware-servicepath",
                "value": "/"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://{{url}}:1026/v2/subscriptions",
              "protocol": "http",
              "host": [
                "{{url}}"
              ],
              "port": "1026",
              "path": [
                "v2",
                "subscriptions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Historico do SEP System\",\n  \"subject\": {\n    \"entities\": [\n      {\n        \"id\": \"urn:ngsi-ld:CaixaDagua:001\",\n        \"type\": \"CaixaDagua\"\n      }\n    ],\n    \"condition\": {\n      \"attrs\": [\n        \"nivel\",\n        \"vazao\",\n        \"estado\"\n      ]\n    }\n  },\n  \"notification\": {\n    \"http\": {\n      \"url\": \"http://fiware-sth-comet:8666/notify\"\n    },\n    \"attrs\": [\n      \"nivel\",\n      \"vazao\",\n      \"hora\",\n      \"estado\"\n    ],\n    \"attrsFormat\": \"legacy\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
